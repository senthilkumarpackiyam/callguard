# Template for your secret keys. The real values go in .env (same names), never here.
# .env is on the .gitignore list, so Git never saves it. Never paste keys into chat or code.

# NVD (free, optional: a key raises the download rate limit): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Nebius Token Factory (required: embeddings and answers): https://tokenfactory.nebius.com
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# LangSmith (free tier, optional: records each question for replay; without a key, tracing stays off)
# https://smith.langchain.com, then Settings > API Keys
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=callguard
